<?xml version="1.0" encoding="utf-8"?>
<!-- Знак OneBar — «каретка в поле»: stadium-обводка поля, курсор слева, точка-подсказка справа.
     Геометрия в 24-сетке, группа масштабирует её в safe zone адаптивной иконки (66 из 108 dp):
     2.6 × 21.8 dp ≈ 57 dp по ширине, центр совмещён с центром канвы. Тот же слой идёт в
     monochrome, поэтому цвет один — launcher_foreground. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="2.6"
        android:scaleY="2.6"
        android:translateX="22.8"
        android:translateY="17.6">
        <path
            android:pathData="M8.4,8 L15.6,8 A6,6 0 0 1 15.6,20 L8.4,20 A6,6 0 0 1 8.4,8 Z"
            android:strokeColor="@color/launcher_foreground"
            android:strokeWidth="2.6" />
        <path
            android:pathData="M8.6,11.4 L8.6,16.6"
            android:strokeColor="@color/launcher_foreground"
            android:strokeLineCap="round"
            android:strokeWidth="2" />
        <path
            android:fillColor="@color/launcher_foreground"
            android:pathData="M15.6,12.3 A1.7,1.7 0 1 1 15.6,15.7 A1.7,1.7 0 1 1 15.6,12.3 Z" />
    </group>
</vector>
